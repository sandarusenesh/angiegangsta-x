# ===== ANGIE GANGSTA X configuration =====
# Copy this file to .env and fill in what you want.
# Everything here is OPTIONAL — the bot works with zero env vars
# (owner is auto-detected from the linked WhatsApp number).

# Port for the built-in web console (health, QR, pairing) — Railway/Render set this automatically
PORT=3000

# Owner (leave empty to auto-detect from the linked number)
OWNER_NUMBER=
OWNER_NAME=Cyzer

# Bot identity
BOT_NAME=ZZZ
PREFIX=.

# Auto pairing: if set, the bot prints a pairing code for this number on first run
# (instead of scanning the QR). Leave empty to use QR / web console.
PAIR_PHONE=

# AI (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Gemini-OpenAI-compat, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Baileys session folder
SESSION_DIR=session
